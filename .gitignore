.DS_Store
.idea
sublime/Packages/User/Package Control.cache
vim/.vim/bundle
vim/.vim/autoload

# TPM-managed plugins (installed by tpm, not tracked)
tmux/.tmux/plugins/

# Work environment (cloned separately)
env/work/

# Local planning / research notes (kept out of the repo)
plans/

# Mise local config (machine-specific env vars)
mise/.config/mise/config.local.toml

# Herdr runtime artifacts (config.toml is tracked; these are per-machine state)
herdr/.config/herdr/*.log
herdr/.config/herdr/session.json
herdr/.config/herdr/*.sock

# Claude
CLAUDE.local.md
.claude/settings.local.json
